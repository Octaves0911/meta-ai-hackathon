# MeetPilot production settings. Copy the names into your host's "secrets" and "variables" (never commit real values).
# Generate the three random secrets with:  infra/deploy/gen-secrets.sh
# Features marked [optional] work without that key and degrade as described.

# ---- required --------------------------------------------------------------------------------------------------------
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require   # Neon (free) works; the first start runs every migration, including `create extension vector`
INTERNAL_SECRET=                      # 24+ random characters: the backend, AI service and connector trust each other with it
LLM_API_KEY=                          # your Meta Model API key (all agents, the live assistant, review chat, tool calling, streaming, vision)
TOKEN_ENC_KEY=                        # base64 of 32 random bytes: encrypts saved Google and GitHub tokens. Keep it; changing it invalidates saved tokens
WEB_URL=https://YOUR-PUBLIC-URL       # where the app is served (used for Google sign-in redirects and links)

# ---- models and cost -------------------------------------------------------------------------------------------------
LLM_MODEL=muse-spark-1.3              # production model. muse-spark-1.3-contributor is cheaper but Meta MAY TRAIN on prompts: demo data only
AGENT_MODEL_RESEARCH=muse-wonder-1.0  # [optional] deeper reasoning for research and code
AGENT_MODEL_CODE=muse-wonder-1.0
AGENT_DAILY_CAP_USD=1                 # spend cap per project per day (the URL is public: keep this low)
MEETING_TZ=Asia/Kolkata               # resolves spoken dates like "Friday"
EMBEDDING_PROVIDER=fake               # fake = offline hashed words (no extra key). `real` uses the AI service /embed

# ---- live captions ---------------------------------------------------------------------------------------------------
STT_MODE=stream                       # stream = Deepgram | mock = fake captions, no key | off
DEEPGRAM_API_KEY=                     # [optional] needed for STT_MODE=stream (Deepgram's free credit is enough for a hackathon)

# ---- Gmail and Drive (optional) -------------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=                     # [optional] without these the Integrations page cannot connect Google
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-PUBLIC-URL/api/connections/google/callback   # also add it in Google Cloud Console

# ---- video calls across strict networks (optional) -------------------------------------------------------------------
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=                            # [optional] e.g. turn:global.relay.metered.ca:80,turns:global.relay.metered.ca:443 (free relay from metered.ca)
TURN_USERNAME=
TURN_CREDENTIAL=

# ---- generated code verification and pull requests (optional) --------------------------------------------------------
SANDBOX_MODE=off                      # off = code changes are labelled "Not tested". modal = verified in a Modal sandbox
MODAL_TOKEN_ID=                       # [optional] with SANDBOX_MODE=modal. Create at modal.com/settings/tokens
MODAL_TOKEN_SECRET=
# GitHub: each project owner pastes a fine-grained token in the app (Integrations page); it is stored encrypted. Nothing to set here.

# ---- first run -------------------------------------------------------------------------------------------------------
SEED_DEMO=1                           # loads a demo project once; set back to 0 afterwards
SEED_DEMO_USER=aman                   # the username that is added to the demo project
