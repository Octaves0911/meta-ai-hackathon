# Copy to .env (infra/start.sh does this automatically for local dev)
DATABASE_URL=postgres://meetpilot:meetpilot@localhost:5432/meetpilot
INTERNAL_SECRET=dev-only-change-me

# Speech
STT_MODE=off            # stream (Deepgram) | mock (fake captions, no key) | off. async fallback: not implemented yet
DEEPGRAM_API_KEY=
# DEEPGRAM_URL=wss://api.deepgram.com/v1/listen

# AI service
LLM_API_KEY=            # empty => backend falls back to rules-based extractor/judge/answerer
LLM_MODEL=              # default claude-sonnet-5-5
# AGENTS_MODE=mock       # offline deterministic agent deliverables (no LLM key needed)
# LLM_API_URL=https://api.anthropic.com/v1/messages
# INSIGHT_TICK_MS=5000  # pipeline poll interval
EMBEDDING_PROVIDER=fake # fake (offline, hashed words) | real (AI service /embed; needs the key below)
# EMBEDDING_API_KEY=       # AI service: any OpenAI-compatible embeddings endpoint
# EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
# EMBEDDING_MODEL=text-embedding-3-small

# Google connector
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENC_KEY=          # 32 bytes, base64 (infra/start.sh generates one if empty)
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/connections/google/callback   # must be registered in Google Cloud
# CONNECTOR_URL=http://localhost:6100

# Governor
AI_GOVERNOR_MAX_CHAT=6
AI_GOVERNOR_WINDOW_MIN=30

# Time zone used to resolve spoken dates like "Friday" or "tomorrow" (default: the server's zone)
# MEETING_TZ=Asia/Kolkata
# WEB_URL=http://localhost:5173   # where the browser returns after Google sign-in

# Operations (docs/08-operations.md)
# RATE_LIMIT_PER_MIN=120   # per user per minute; 0 disables (useful when re-running smoke tests)
# LOG_LEVEL=info
# DB_POOL_MAX=20
# DB_STATEMENT_TIMEOUT_MS=30000
# NODE_ENV=production      # services then refuse a weak INTERNAL_SECRET (>= 24 chars, not the example)
