# Copy to .env (infra/start.sh does this automatically for local dev)
DATABASE_URL=postgres://meetpilot:meetpilot@localhost:5432/meetpilot
INTERNAL_SECRET=dev-only-change-me

# Speech
STT_MODE=off            # stream (Deepgram) | mock (fake captions, no key) | off. async fallback: not implemented yet
DEEPGRAM_API_KEY=
# DEEPGRAM_URL=wss://api.deepgram.com/v1/listen

# AI service
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_PROVIDER=fake # fake (offline, hashed words) | real (AI service /embed; needs the key below)
# EMBEDDING_API_KEY=       # AI service: any OpenAI-compatible embeddings endpoint
# EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
# EMBEDDING_MODEL=text-embedding-3-small

# Google connector
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENC_KEY=          # 32 bytes, base64

# Governor
AI_GOVERNOR_MAX_CHAT=6
AI_GOVERNOR_WINDOW_MIN=30
