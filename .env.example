# Copy to .env (infra/start.sh does this automatically for local dev)
DATABASE_URL=postgres://meetpilot:meetpilot@localhost:5432/meetpilot
INTERNAL_SECRET=dev-only-change-me

# Speech
STT_MODE=off            # stream | async | off
DEEPGRAM_API_KEY=

# AI service
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_PROVIDER=fake # real | fake

# Google connector
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENC_KEY=          # 32 bytes, base64

# Governor
AI_GOVERNOR_MAX_CHAT=6
AI_GOVERNOR_WINDOW_MIN=30
